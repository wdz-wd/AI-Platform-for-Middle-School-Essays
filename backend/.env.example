DATABASE_URL="postgresql://postgres:your-postgres-password@localhost:5432/essay_review?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
UPLOAD_DIR="../uploads"
OCR_PROVIDER="baidu"
# 两个队列各自限流；一篇识别完成后即可进入批阅队列。
OCR_CONCURRENCY=2
REVIEW_CONCURRENCY=2
# 单轮 Paddle 重试耗尽后，后台按保存的进度延迟续接；默认最多再续接 10 轮。
OCR_AUTO_RETRY_MAX_ATTEMPTS=10
OCR_AUTO_RETRY_BASE_MS=60000
BAIDU_OCR_API_KEY="your-baidu-ocr-api-key"
BAIDU_OCR_SECRET_KEY="your-baidu-ocr-secret-key"
BAIDU_OCR_TOKEN_URL="https://aip.baidubce.com/oauth/2.0/token"
BAIDU_OCR_POLL_INTERVAL_MS=4000
BAIDU_OCR_MAX_ATTEMPTS=16
BAIDU_OCR_REFRESH_BUFFER_MS=86400000
PADDLE_OCR_API_URL="https://paddleocr.aistudio-app.com/api/v2/ocr/jobs"
PADDLE_OCR_TOKEN="your-paddle-ocr-token"
PADDLE_OCR_MODEL="PaddleOCR-VL-1.6"
PADDLE_OCR_POLL_INTERVAL_MS=5000
PADDLE_OCR_MAX_ATTEMPTS=120
# 所有 Paddle 全文提交/查询共用请求间隔；不再裁剪姓名栏另行识别。
# 限流后自动降速，连续成功 20 次后逐步恢复；启动日志标识“限流保护 v2”。
PADDLE_OCR_REQUEST_INTERVAL_MS=2000
# 临时限流最多重试 5 次，按 5/10/20/40/60 秒退避并遵守 Retry-After。
PADDLE_OCR_MAX_RETRIES=5
PADDLE_OCR_RETRY_BASE_MS=5000
PADDLE_OCR_USE_DOC_ORIENTATION_CLASSIFY=false
PADDLE_OCR_USE_DOC_UNWARPING=false
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
APP_ORIGIN="http://localhost:5173"
PORT=3000
